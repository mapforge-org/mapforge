%footer#footer.footer.light-background.pb-2{ data: { 'controller': "header", 'action': "click->header#hideNavDropdown" } }
  .container
    .row.gy-4
      - # language block is on the left on lg screen, below the links on smaller screens
      - # screen < sm, contact moves below links
      .col-lg-5.col-12.order-last.order-lg-first.footer-links
        %nav{ 'aria-label': _("Language") }
          %ul.d-flex.justify-content-center.justify-content-lg-start.gap-3
            - ApplicationHelper::LANGUAGES.each do |locale, name|
              %li.pt-0
                - # The gettext JS in the head differs per language, so this needs a full page load
                %a{ href: "?#{request.query_parameters.merge(locale: locale).to_query}", lang: locale, hreflang: locale, data: { turbo: false }, 'aria-current': ('true' if I18n.locale.to_s == locale) }
                  %i.bi.bi-translate.me-1>
                  = name

      .col-lg-2.col-sm-4.col-6.footer-links.footer-links-left.mb-sm-2
        %h3.mapforge-font.white-shadow= _("Docs")
        %ul
          %li
            %a{ href: docs_path }
              %i.bi.bi-file-text.me-1>
              = _("Tutorials")
          %li
            %a{ href: doc_path(id: 'CHANGELOG') }
              %i.bi.bi-file-text.me-1>
              = _("Changelog")
          %li
            %a{ href: doc_path(id: 'ulogger') }
              %i.bi.bi-file-text.me-1>
              = "µlogger API"
          %li
            %a{ href: doc_path(id: 'credits') }
              %i.bi.bi-file-text.me-1>
              = _("Credits")
      .col-lg-2.col-sm-4.col-6.footer-links
        %h3.mapforge-font.white-shadow= _("Project")
        %ul
          %li
            %a{ href: "https://github.com/mapforge-org/mapforge/" }
              %i.bi.bi-github.me-1>
              = "Github"
          %li
            %a{ href: "https://github.com/mapforge-org/mapforge/discussions" }
              %i.bi.bi-chat.me-1>
              = _("Discuss")
          %li
            %a{ href: "https://github.com/mapforge-org/mapforge/issues/new" }
              %i.bi.bi-github.me-1>
              = _("Report issue")
          %li
            %a{ href: doc_path(id: 'CONTRIBUTING') }
              %i.bi.bi-file-text.me-1>
              = _("Contributing")
          %li
            %a.footer-coffee{ href: "https://buymeacoffee.com/mapforge" }
              %i.bi.bi-cup-hot.me-1>
              = _("Buy me a coffee")
      .col-lg-3.col-sm-4.mx-auto.footer-links.footer-links-about.text-center.text-sm-start.text-md-start.mb-2
        %div
          %h3.mapforge-font.white-shadow= _("About")
          %ul
            %li
              .text-nowrap
                %strong
                  %i.bi.bi-envelope.me-1
                %span mapforge@mapforge.org
            %li
              %a{ href: doc_path(id: 'terms') }
                %i.bi.bi-file-text.me-1>
                = _("Terms of Service")
            %li
              %a{ href: doc_path(id: 'privacy') }
                %i.bi.bi-file-text.me-1>
                = _("Privacy Policy")
