    <circle cx="223" cy="115" r="16" stroke="hsl(120 85% 45%)" stroke-width="3"/>
    <g font-family="SUSE, system-ui, sans-serif" font-weight="600" stroke="none">
      <g font-size="24" fill="#b85e1e">
        <text x="55" y="436">#{edit_link}</text>
        <text x="630" y="530">#{view_link}</text>
        <text x="190" y="656">#{embedding}</text>
        <text x="597" y="656">#{public_label}</text>
      </g>
    </g>
    <g font-family="Caveat, cursive" font-weight="700" stroke="none">
      <text x="506" y="72" font-size="32" fill="#b85e1e" transform="rotate(-6 506 72)">#{same_map}</text>
      <g fill="#33502a">
        <text x="55" y="400" font-size="44">#{team}</text>
        <text x="630" y="492" font-size="44">#{guests}</text>
        <text x="190" y="622" font-size="36">#{on_website}</text>
        <text x="597" y="622" font-size="36">#{in_gallery}</text>
      </g>
    </g>
