    <image x="522" y="630" width="56" height="42" preserveAspectRatio="xMidYMid slice" href="/images/frontpage/features/terrain.webp?v=2"/>
    <g filter="url(#share-hand)">
      <rect x="90" y="36" width="388" height="266" rx="6"/>
      <rect x="650" y="98" width="158" height="312" rx="10"/>
      <rect x="48" y="610" width="62" height="50" rx="3"/>
      <rect x="457" y="578" width="56" height="42" rx="4"/>
      <rect x="522" y="578" width="56" height="42" rx="4"/>
      <rect x="457" y="630" width="56" height="42" rx="4"/>
      <rect x="522" y="630" width="56" height="42" rx="4"/>
