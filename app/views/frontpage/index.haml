- content_for :head do
  %link{ rel: "canonical", href: localized_root_url(I18n.locale) }
  - ApplicationHelper::LANGUAGES.each_key do |locale|
    %link{ rel: "alternate", hreflang: locale, href: localized_root_url(locale) }
  %link{ rel: "alternate", hreflang: "x-default", href: localized_root_url(I18n.default_locale) }

%main#frontpage.main.selectable{ data: { 'controller': "header frontpage-route", 'action': "click->header#hideNavDropdown" } }
  %section.landing-hero
    .landing-wrap.landing-hero-grid
      .landing-hero-text
        / News badge – update the text below to advertise new features or site news.
        / Remove or comment out this block when there is nothing to announce.
        %a.landing-badge{ href: doc_path(id: 'bike_touring') }
          %span.landing-badge-label= _("New")
          = _("Bicycle tour planning: how it works") + "\u00A0→"

        %h1.mapforge-font{ data: { 'frontpage-route-target': "headline" } }= _("Create your own map")
        %p.landing-lead
          = _("Your free map editor built on OpenStreetMap.")
          %br
          = _("Create individual maps for your places, tracks and events.")

        .landing-actions{ data: { 'frontpage-route-target': "actions" } }
          - if @user
            = button_to _("Start a map"), create_map_path, class: 'btn btn-orange btn-lg', form_class: 'button_to landing-start-map'
            = link_to my_path, class: 'btn btn-outline-light btn-lg' do
              = _("Your maps")
              - if owned_maps_count.positive?
                %span.landing-count= owned_maps_count
          - else
            = button_to _("Start for free"), create_map_path, class: 'btn btn-orange btn-lg'
          = link_to _("Playground"), playground_path, class: 'btn btn-outline-light btn-lg'

        %ul.landing-checks
          - [_("Open Source"), _("Ad-free and no tracking"), _("Self-hostable")].each do |check|
            %li
              %i.bi.bi-geo-alt-fill{ data: { 'frontpage-route-target': "hero" } }
              = check

      - # preload none: the file only loads when the visitor presses play
      %figure.landing-video{ data: { controller: "hero-video" } }
        .landing-video-frame
          %video{ src: "/images/frontpage/demo.mp4", poster: "/images/frontpage/demo_poster.webp?v2", width: 700, height: 436,
                  preload: "none", muted: true, playsinline: true, tabindex: 0,
                  'aria-label': _("Demo: a map with routes, photos and 3D buildings takes shape"),
                  data: { 'hero-video-target': "video",
                          action: "click->hero-video#toggle keydown.enter->hero-video#toggle keydown.space->hero-video#toggle:prevent play->hero-video#syncOverlay pause->hero-video#syncOverlay" } }
          %button.landing-video-play{ type: "button", 'aria-label': _("Play video"),
                                      data: { 'hero-video-target': "overlay", action: "click->hero-video#toggle" } }
            %i.bi.bi-play-fill
          %span.landing-video-length{ data: { 'hero-video-target': "overlay" } } 0:57

  %section.landing-stats{ data: { 'frontpage-route-target': "stats" } }
    .landing-wrap
      .landing-stats-grid{ 'data-animate': "fade-up" }
        .landing-stat
          %span.landing-stat-icon
            %i.bi.bi-map
          %div
            .landing-stat-value.mapforge-font= number_with_delimiter(@stats[:maps])
            .landing-stat-label= _("maps created")
        .landing-stat
          %span.landing-stat-icon
            %i.bi.bi-people
          %div
            .landing-stat-value.mapforge-font= number_with_delimiter(@stats[:users])
            .landing-stat-label= _("registered users")
        %a.landing-stat{ href: "https://github.com/mapforge-org/mapforge/" }
          %span.landing-stat-icon.landing-stat-icon-accent
            %i.bi.bi-star
          %div
            .landing-stat-value.mapforge-font= number_with_delimiter(@build[:stars])
            .landing-stat-label= _("Stars on GitHub")
          %i.bi.bi-arrow-up-right.landing-stat-link
        %a.landing-stat{ href: doc_path(id: 'CHANGELOG') }
          %span.landing-stat-icon.landing-stat-icon-accent
            %i.bi.bi-tag
          %div
            .landing-stat-value.mapforge-font= @build[:release] || @build[:sha]&.first(7) || @stats[:updated]
            .landing-stat-label= _("Latest changes")
          %i.bi.bi-arrow-up-right.landing-stat-link

  %section.landing-features.background-bright
    .landing-wrap
      %h2.mapforge-font= _("Build the map you have in mind")
      %p.landing-features-lead= _("Plan a bicycle tour, map the floor plan for your conference, or create a guide for your wedding guests")
      .landing-features-grid{ data: { 'frontpage-route-target': "grid" } }
        - overpass_link = link_to 'Overpass', doc_path(id: 'overpass_layers')
        - # The pin is a point in the 320x130 SVG drawing
        - [["import", _("Import your data"), _("Import from GeoJSON, GPX and KML/KMZ"), [118, 92]],
           ["draw", _("Draw and style"), _("Add pictures, customize colors, symbols, labels, (3D) polygons, indoor maps and more")],
           ["routing", _("Routing with elevation profile"), _("Plan routes for walking, bicycle and car"), [268, 73]],
           ["layers", _("Dynamic layers"), raw(_("Show live OpenStreetMap data with %{overpass_link}") % { overpass_link: overpass_link })],
           ["basemaps", _("Base maps"), _("Streets, Satellite, Topographic, Biking, Watercolor, 3D houses")],
           ["terrain", _("3D Terrain"), _("View your map with mountains and valleys")]].each do |art, title, text, pin|
          %article.landing-feature
            .landing-feature-art
              - # Raise v when a tile image changes: public/ files have no digest, browsers cache them for a month
              %img.landing-feature-photo{ class: "landing-feature-photo-#{art}", src: "/images/frontpage/features/#{art}.webp?v=2", alt: "", loading: 'lazy' }
              %img{ src: "/images/frontpage/features/#{art}.svg?v=3", width: 320, height: 130, alt: "" }
              - if pin
                %i.bi.bi-geo-alt-fill.landing-route-pin{ style: "--x: #{pin[0]}; --y: #{pin[1]}", data: { 'frontpage-route-target': "feature" } }
            %h3= title
            %p= text

  %section#features.section
    - ulogger_link = link_to "µlogger", "https://github.com/mapforge-org/mapforge/blob/main/engines/ulogger/README.md"
    - [["share.webp", _("Share dialog with an edit link and a view link over a 3D map"), _("Share"),
        _("One link to view, one to edit"), _("Publish in the gallery or share privately – you decide."),
        [[_("Embedding"), _("your map on any web page.")],
         [_("Real-time"), _("changes are visible to everyone right away.")],
         [_("Account"), _("all your maps in one place.")]]],
       ["on_the_go.webp", _("The same map on a laptop, a tablet and a phone"), _("On the go"),
        _("The map goes with you"), _("Plan on desktop, edit in the field on your phone."),
        [[_("GPS & compass"), _("the map shows where you are.")],
         [link_to(_("Install as an app"), doc_path(id: 'app')), _("right from the browser.")],
         [_("Live tracking"), raw(_("share your track in real time with %{ulogger_link}.") % { ulogger_link: ulogger_link })]]]].each do |image, alt, eyebrow, title, lead, stops|
      .landing-showcase.background-bright{ data: { 'frontpage-route-target': "showcase" } }
        .landing-wrap.landing-showcase-grid
          %img{ src: "/images/frontpage/#{image}", alt: alt, loading: 'lazy' }
          %div
            .landing-eyebrow= eyebrow
            %h2.mapforge-font= title
            %p.landing-showcase-lead= lead
            %ul.landing-stops
              - stops.each do |term, text|
                %li
                  %i.bi.bi-geo-alt-fill.landing-route-pin{ data: { 'frontpage-route-target': "stop" } }
                  %strong= term
                  &ndash;
                  = text
    - if @featured_maps.present?
      = render "featured_maps"

    .landing-showcase.background-bright
      .landing-wrap
        .landing-showcase-grid
          %div
            .landing-eyebrow= _("Open Source")
            %h2.mapforge-font= _("The code is open. Your data is yours.")
            %p.landing-showcase-lead= _("No ads, no tracking, no lock-in. Export anytime as GPX or GeoJSON – or run Mapforge on your own server.")
            .landing-actions
              = link_to "https://github.com/mapforge-org/mapforge", class: 'btn btn-outline-light btn-lg' do
                = _("View on GitHub")
                %i.bi.bi-box-arrow-up-right.ms-1
              = link_to _("Self-hosting guide"), "https://github.com/mapforge-org/mapforge/blob/main/SELF-HOSTING.md", class: 'nav-link'
          .landing-built-with
            .landing-built-with-title= _("Built with")
            .landing-chips
              - [["Ruby on Rails", "https://rubyonrails.org/"],
                 ["MongoDB", "https://www.mongodb.com/"],
                 ["MapLibre GL JS", "https://github.com/maplibre/maplibre-gl-js"],
                 ["OpenStreetMap", "https://www.openstreetmap.org"],
                 ["mapbox-gl-draw", "https://github.com/mapbox/mapbox-gl-draw"],
                 ["Turf.js", "https://turfjs.org/"],
                 ["Pinhead", "https://github.com/waysidemapping/pinhead"],
                 ["Openrouteservice", "https://openrouteservice.org/"]].each do |name, url|
                = link_to name, url, class: 'landing-chip'

        .landing-cta{ data: { 'frontpage-route-target': "cta" } }
          %h2.mapforge-font= @user ? _("Ready for your next map?") : _("Ready for your first map?")
          - unless @user
            %p= _("Free to try, no signup needed.")
          .landing-cta-action
            %i.bi.bi-flag-fill.landing-route-pin{ data: { 'frontpage-route-target': "flag" } }
            = button_to _("Create a new map"), create_map_path, class: 'btn btn-orange btn-lg'

  %svg.landing-route{ 'aria-hidden': "true" }
    %defs
      %clipPath#landing-route-photo
        %rect{ data: { 'frontpage-route-target': "photo" } }
    %path{ data: { 'frontpage-route-target': "path" } }
    %path.landing-route-chevrons{ data: { 'frontpage-route-target': "chevrons" } }
    %g.landing-route-light{ 'clip-path': "url(#landing-route-photo)" }
      %path{ data: { 'frontpage-route-target': "lightRoute" } }
      %path.landing-route-chevrons{ data: { 'frontpage-route-target': "lightChevrons" } }
    %circle{ r: 6, data: { 'frontpage-route-target': "start" } }
