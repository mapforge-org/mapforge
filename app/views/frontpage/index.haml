- content_for :head do
  %link{ rel: "canonical", href: localized_root_url(I18n.locale) }
  - ApplicationHelper::LANGUAGES.each_key do |locale|
    %link{ rel: "alternate", hreflang: locale, href: localized_root_url(locale) }
  %link{ rel: "alternate", hreflang: "x-default", href: localized_root_url(I18n.default_locale) }

%main#frontpage.main.selectable{ data: { 'controller': "header frontpage-route", 'action': "click->header#hideNavDropdown" } }
  %section.landing-hero
    .landing-wrap.landing-hero-grid
      .landing-hero-text
        / News badge – update the text below to advertise new features or site news.
        / Remove or comment out this block when there is nothing to announce.
        %a.landing-badge{ href: doc_path(id: 'bike_touring') }
          %span.landing-badge-label= _("New")
          = _("Bicycle tour planning: how it works →")

        %h1.mapforge-font= _("Create your own map")
        %p.landing-lead
          = _("Your free map editor built on OpenStreetMap.")
          %br
          = _("Create individual maps for your places, tracks and events.")

        .landing-actions
          = button_to (@user ? _("Start a map") : _("Start for free")), create_map_path, class: 'btn btn-orange btn-lg'
          - if @user
            = link_to _("Your maps"), my_path, class: 'btn btn-outline-light btn-lg'
          = link_to _("Playground"), playground_path, class: 'btn btn-outline-light btn-lg'

        %ul.landing-checks
          %li
            %i.bi.bi-geo-alt-fill{ data: { 'frontpage-route-target': "hero" } }
            = _("Open Source")
          %li
            %i.bi.bi-geo-alt-fill{ data: { 'frontpage-route-target': "hero" } }
            = _("Ad-free and no tracking")
          %li
            %i.bi.bi-geo-alt-fill{ data: { 'frontpage-route-target': "hero" } }
            = _("Self-hostable")

      - # demo.webp is 3 MB and plays on its own, so it only loads on request
      %figure.landing-video{ data: { controller: "hero-video" } }
        .landing-video-frame
          %img{ src: "/images/frontpage/demo_poster.webp", width: 1200, height: 732, alt: _("Demo: a map with routes, photos and 3D buildings takes shape"),
                data: { 'hero-video-target': "image", src: "/images/frontpage/demo.webp?v2" } }
          %button.landing-video-play{ type: "button", 'aria-label': _("Play video"),
                                      data: { 'hero-video-target': "overlay", action: "click->hero-video#play" } }
            %i.bi.bi-play-fill
          %span.landing-video-length{ data: { 'hero-video-target': "overlay" } } 0:51
        %figcaption= _("Watch a map take shape: routes, photos, areas and 3D buildings.")

  %section.landing-stats{ data: { 'frontpage-route-target': "stats" } }
    .landing-wrap
      .landing-stats-grid{ 'data-animate': "fade-up" }
        .landing-stat
          %span.landing-stat-icon
            %i.bi.bi-map
          %div
            .landing-stat-value.mapforge-font= number_with_delimiter(@stats[:maps])
            .landing-stat-label= _("maps created")
        .landing-stat
          %span.landing-stat-icon
            %i.bi.bi-people
          %div
            .landing-stat-value.mapforge-font= number_with_delimiter(@stats[:users])
            .landing-stat-label= _("registered users")
        %a.landing-stat{ href: "https://github.com/mapforge-org/mapforge/" }
          %span.landing-stat-icon.landing-stat-icon-accent
            %i.bi.bi-star
          %div
            .landing-stat-value.mapforge-font= number_with_delimiter(@build[:stars])
            .landing-stat-label= _("Stars on GitHub")
          %i.bi.bi-arrow-up-right.landing-stat-link
        %a.landing-stat{ href: doc_path(id: 'CHANGELOG') }
          %span.landing-stat-icon.landing-stat-icon-accent
            %i.bi.bi-tag
          %div
            .landing-stat-value.mapforge-font= @build[:release] || @build[:sha]&.first(7) || @stats[:updated]
            .landing-stat-label= _("Latest changes")
          %i.bi.bi-arrow-up-right.landing-stat-link

  %section.landing-features
    .landing-wrap
      .landing-features-eyebrow= _("Features")
      %h2.mapforge-font= _("Build the map you have in mind")
      %p.landing-features-lead= _("A bicycle tour, the floor plan for your conference, a guide for your wedding guests")
      .landing-features-grid{ data: { 'frontpage-route-target': "grid" } }
        - overpass_link = link_to 'Overpass', doc_path(id: 'overpass_layers')
        - [["import", _("Import your data"), _("Import from GeoJSON, GPX and KML/KMZ")],
           ["draw", _("Draw and style"), _("Add pictures, customize colors, symbols, labels, (3D) polygons, indoor maps and more")],
           ["routing", _("Routing with elevation profile"), _("Plan routes for walking, bicycle and car")],
           ["layers", _("Dynamic layers"), raw(_("Show live OpenStreetMap data with %{overpass_link}") % { overpass_link: overpass_link })],
           ["basemaps", _("Base maps"), _("Streets, Satellite, Topographic, Biking, Watercolor, 3D houses")],
           ["terrain", _("3D Terrain"), _("View your map with mountains and valleys")]].each do |art, title, text|
          %article.landing-feature
            .landing-feature-art
              %img{ src: "/images/frontpage/features/#{art}.svg", width: 320, height: 130, alt: "", loading: 'lazy' }
              - if %w[import routing].include?(art)
                %i.bi.bi-geo-alt-fill.landing-route-pin{ class: "landing-route-pin-#{art}", data: { 'frontpage-route-target': "feature" } }
            %h3= title
            %p= text

  %section#features.why-us.section
    .row.g-0
      .col-lg-5.img-bg.order-lg-last
        %img{ src: "/images/frontpage/share.webp", alt: _("Share dialog with an edit link and a view link over a 3D map"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %i.bi.bi-geo-alt-fill.landing-route-pin{ data: { 'frontpage-route-target': "row" } }
          %h2.mb-3.mapforge-font= _("One link to view, one to edit")
          %h3.mb-3= _("Listed in the gallery, or shared privately")
          %ul
            %li= _("Embedding: Include your map on your own web page")
            %li= _("Real-time: Map changes are synchronized to all users")
            %li= _("Login: Have your maps assigned to your account")
    .row.g-0
      .col-lg-5.img-bg
        %img{ src: "/images/frontpage/feature2.png", alt: _("The same map on a laptop, a tablet and a phone"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %i.bi.bi-geo-alt-fill.landing-route-pin{ data: { 'frontpage-route-target': "row" } }
          %h2.mb-3.mapforge-font= _("The map goes with you")
          %h3.mb-3= _("Plan on desktop, run Mapforge on your phone, edit in the field, stream your track live")
          %ul
            %li= _("GPS and compass: The map follows your position and turns with you")
            %li
              - app_link = link_to _('app on your phone'), doc_path(id: 'app')
              = raw(_("Run in desktop/mobile browser or as %{app_link}") % { app_link: app_link })
            %li
              - ulogger_link = link_to "µlogger", "https://github.com/mapforge-org/mapforge/blob/main/engines/ulogger/README.md"
              = raw(_("Map your track: Use %{ulogger_link} to visualize and share your tracks live") % { ulogger_link: ulogger_link })
    .row.g-0
      .col-lg-5.img-bg.order-lg-last
        %img{ src: "/images/frontpage/feature3.png", alt: _("Globe with a heart over Central Europe"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %i.bi.bi-geo-alt-fill.landing-route-pin{ data: { 'frontpage-route-target': "row" } }
          %h2.mb-3.mapforge-font= _("Open Source")
          %h3.mb-3= _("The code is public, map data is owned by you")
          %ul
            %li= _("No ads, no tracking, no lock-in")
            %li
              - deploy_link = link_to _('run Mapforge on your own server'), "https://github.com/mapforge-org/mapforge/blob/main/SELF-HOSTING.md"
              = raw(_("Export your maps as GPX/GeoJSON, or %{deploy_link}") % { deploy_link: deploy_link })
            %li
              - rails_link = link_to "Ruby on Rails", "https://rubyonrails.org/"
              - mongodb_link = link_to "MongoDB", "https://www.mongodb.com/"
              - maplibre_link = link_to "MapLibre GL JS", "https://github.com/maplibre/maplibre-gl-js"
              - osm_link = link_to "OpenStreetMap", "https://www.openstreetmap.org"
              - draw_link = link_to "mapbox-gl-draw", "https://github.com/mapbox/mapbox-gl-draw"
              - turf_link = link_to "Turf.js", "https://turfjs.org/"
              - pinhead_link = link_to "Pinhead", "https://github.com/waysidemapping/pinhead"
              - ors_link = link_to "Openrouteservice", "https://openrouteservice.org/"
              = raw(_("Built with %{rails_link}, %{mongodb_link}, %{maplibre_link}, %{osm_link}, %{draw_link}, %{turf_link}, %{pinhead_link} and %{ors_link}") % { rails_link: rails_link, mongodb_link: mongodb_link, maplibre_link: maplibre_link, osm_link: osm_link, draw_link: draw_link, turf_link: turf_link, pinhead_link: pinhead_link, ors_link: ors_link })

  - if @featured_maps.present?
    %section.featured-maps.section.background-bright
      = render "featured_maps"

  %svg.landing-route{ 'aria-hidden': "true" }
    %path{ data: { 'frontpage-route-target': "path" } }
