%main#frontpage.main.selectable{ data: { 'controller': "header", 'action': "click->header#hideNavDropdown" } }
  / Hero Section
  #hero.hero.section.dark-background
    .hero-bg-image{ 'data-aos': "zoom-out", 'data-aos-once': "true" }

    .container
      .row
        .col-lg-6.welcome-text
          %h1.mapforge-font{ 'data-aos': "fade-up" }= _("Create your own map")

          %div{ 'data-aos': "fade-up" }
            %blockquote{ 'data-aos': "fade-up" }
              %p.d-none.d-sm-block
                = _("Your free, open-source map editor built on OpenStreetMap. Create individual maps for your places, tracks and events - customize, collaborate and share in real-time.")
              %p.d-sm-none
                = _("Your open-source map editor built on OpenStreetMap. Create individual maps for your places, tracks and events.")
              %p.d-none.d-sm-block
                = _("Every map has a view link and an edit link. Share them with anyone, list your map in the gallery, or keep it private. Embed it on other sites.")
              %p.d-none.d-sm-block
                = _("Mapforge is ad-free and respects your privacy.")
                = _("Also available for self-hosting, giving you full control over your data.")
              %p.d-sm-none
                - tutorial_link = link_to(_('tutorial map'), tutorial_path, class: 'btn btn-orange call-to-action', data: { turbo_method: :post })
                - if @user
                  - maps_link = link_to(_('your maps'), my_path, class: 'btn btn-orange call-to-action')
                  - create_link = link_to(_('create'), create_map_path, class: 'btn btn-orange call-to-action', data: { turbo_method: :post })
                  = raw(_("Browse %{maps_link}, learn more on the %{tutorial_link} or %{create_link} a new map.") % { maps_link: maps_link, tutorial_link: tutorial_link, create_link: create_link })
                - else
                  - gallery_link = link_to(_('gallery'), maps_path, class: 'btn btn-orange call-to-action')
                  - login_link = link_to(_('log in'), login_path, class: 'btn btn-orange call-to-action')
                  = raw(_("Browse the %{gallery_link}, learn how to use Mapforge on the %{tutorial_link} or %{login_link} to create your own maps.") % { gallery_link: gallery_link, tutorial_link: tutorial_link, login_link: login_link })
            .hero-actions.d-none.d-sm-flex
              - if @user
                = button_to _("Start a map"), create_map_path, class: 'btn btn-orange btn-lg'
                = link_to _("Your maps"), my_path, class: 'btn btn-secondary btn-green'
                = link_to _("Tutorial map"), tutorial_path, class: 'btn btn-secondary btn-green', data: { turbo_method: :post }
              - else
                = button_to _("Tutorial map"), tutorial_path, class: 'btn btn-orange btn-lg'
                = link_to _("Start a map"), create_map_path, class: 'btn btn-secondary btn-green', data: { turbo_method: :post }

        .col-lg-6.featured-maps.d-none.d-lg-block{ 'data-aos': "fade-up" }
          / News Banner – update the text below to advertise new features or site news.
          / Remove or comment out this block when there is nothing to announce.
          .banner-explorer{ role: "note", 'aria-label': _("News") }
            .banner-explorer-inner
              .banner-explorer-content
                %p.banner-title= _("Bicycle Touring!")
                .divider
                %p
                  = _("Tour planning with Mapforge:")
                  %br
                  =link_to _('See how it works'), '/doc/bike_touring'

          - if @featured_maps.present?
            = render "featured_maps"

    .container.feature-tour-col{ 'data-aos': "fade-up", 'data-aos-offset': "0" }
      .col-lg-6.d-flex.justify-content-center
        %a.feature-tour-link{ href: "#features" }
          = _("Feature Tour")
          %i.bi.bi-chevron-double-down

  / Below lg the hero must stay one screen tall with the feature tour link at its bottom,
  / so the featured maps get their own section there.
  - if @featured_maps.present?
    %section.featured-maps.featured-maps-mobile.section.background-bright.d-lg-none
      = render "featured_maps"

  %section#features.why-us.section
    .row.g-0
      .col-lg-5.img-bg
        %img{ src: "/images/frontpage/demo.webp", alt: _("Map tools"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %h2.mb-3.mapforge-font= _("Build the map you have in mind")
          %h4.mb-3= _("A bicycle tour, the floor plan for your conference, a guide for your wedding guests")
          %ul
            %li
              %span.d-none.d-sm-inline><
                = _("Choose your base map: Streets, Satellite, Topographic, Biking, Watercolor, 3D houses etc.")
              %span.d-sm-none><
                = _("Choose your base map: Streets, Satellite, Topographic, Biking")
            %li
              = _("Add your own data:")
              %span.d-none.d-sm-inline
                = _("Import your data from GeoJSON, GPX and KML")
              %span.d-sm-none
                = _("Import from GeoJSON, GPX and KML")
            %li
              = _("Draw shapes and style them:")
              %span.d-none.d-sm-inline<
                = _("Add pictures, customize colors, symbols, labels, (3D) polygons, indoor maps and more")
              %span.d-sm-none
                = _("Add pictures, customize colors, symbols, labels")
            %li
              - overpass_link = link_to 'Overpass', doc_path(id: 'overpass_layers')
              = raw(_("Dynamic layers: Use %{overpass_link} to add custom layers from OpenStreetMap data") % { overpass_link: overpass_link })
            %li= _("Routing: Plan routes for walking, bicycle and car, with elevation profile")
            %li
              %span.d-none.d-sm-inline
                = _("3D Terrain: View your map with realistic elevation")
              %span.d-sm-none
                = _("3D Terrain: View your map with elevation")
    .row.g-0
      .col-lg-5.img-bg.order-lg-last
        %img{ src: "/images/frontpage/feature1.png", alt: _("Collaboration"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %h2.mb-3.mapforge-font= _("One link to view, one to edit")
          %h4.mb-3= _("A view link, an edit link, a gallery listing, or private")
          %ul
            %li= _("Access control: Keep maps private or share with view-only or edit permissions")
            %li= _("Embedding: Include your map on your own web page")
            %li= _("Live updates: Map changes are synchronized via websockets")
            %li= _("Login: Have your maps assigned to your account")
    .row.g-0
      .col-lg-5.img-bg
        %img{ src: "/images/frontpage/feature2.png", alt: _("Cross platform"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %h2.mb-3.mapforge-font= _("Map it while you're out there")
          %h4.mb-3= _("Run Mapforge on your phone, edit in the field, stream your track live")
          %ul
            %li= _("Responsive Design: Works well both on desktop and mobile")
            %li
              - app_link = link_to _('app on your phone'), doc_path(id: 'app')
              = raw(_("Run from your home screen as %{app_link}") % { app_link: app_link })
            %li
              - ulogger_link = link_to "µlogger", "https://github.com/mapforge-org/mapforge/blob/main/engines/ulogger/README.md"
              = raw(_("Map your track: Use %{ulogger_link} to visualize and share your tracks live") % { ulogger_link: ulogger_link })
    .row.g-0
      .col-lg-5.img-bg.order-lg-last
        %img{ src: "/images/frontpage/feature3.png", alt: _("Open Source"), loading: 'lazy' }
      .col-lg-7.background-bright.slides
        .item
          %h2.mb-3.mapforge-font= _("Open Source")
          %h4.mb-3= _("Nobody can take it away from you")
          %ul
            %li= _("No ads, no tracking, no lock-in")
            %li
              - deploy_link = link_to _('run the whole app on your own server'), "https://github.com/mapforge-org/mapforge/blob/main/SELF-HOSTING.md"
              = raw(_("Export your maps as GeoJSON, or %{deploy_link}") % { deploy_link: deploy_link })
            %li.small.text-muted
              - rails_link = link_to "Ruby on Rails", "https://rubyonrails.org/"
              - maplibre_link = link_to "MapLibre GL JS", "https://github.com/maplibre/maplibre-gl-js"
              - osm_link = link_to "OpenStreetMap", "https://www.openstreetmap.org"
              - draw_link = link_to "mapbox-gl-draw", "https://github.com/mapbox/mapbox-gl-draw"
              - turf_link = link_to "Turf.js", "https://turfjs.org/"
              - ors_link = link_to "Openrouteservice", "https://openrouteservice.org/"
              = raw(_("Built with %{rails_link}, %{maplibre_link}, %{osm_link}, %{draw_link}, %{turf_link} and %{ors_link}") % { rails_link: rails_link, maplibre_link: maplibre_link, osm_link: osm_link, draw_link: draw_link, turf_link: turf_link, ors_link: ors_link })
