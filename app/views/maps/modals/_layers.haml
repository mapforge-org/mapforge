#layers-modal.modal-center.fade
  .map-modal{'data-controller': "map--modal map--layers", 'data-action': "keydown.esc@window->map--modal#close"}
    %button.modal-close-button{ data: { action: "click->map--modal#close" } } &times;
    .map-modal-header
      %h3.mapforge-font= _("Layers")

    .map-modal-content.inline-scroll

      - if map_editable?
        .row.align-items-center.rw-only
          .col-6.pe-0
            - if @user
              %label.no-wrap.form-control.btn.btn-blue#file-input-label{ for: "fileInput", title: _('Valid formats are gpx, kml, geojson and image files. WGS84 format, max. 2.5MB') }
                %i.bi.bi-upload.me-1
                = _("Import")
                .d-none.d-sm-inline
                  = _("(track / image)")
              %input.hidden#fileInput{ type: "file", data: { action: "change->map--layers#upload" } }
            - else
              %i.bi.bi-info-circle
                = _("Please log in to upload tracks")

          .col-6.ps-1
            %button#newLayerDropdown.no-wrap.form-control.btn.btn-blue.dropdown-toggle{
              type: "button",
              "data-bs-toggle": "dropdown",
              "aria-expanded": "false"
            }
              %i.bi.bi-plus-square.me-1
              %span.d-none.d-sm-inline= _("Add layer")
              %span.d-sm-none= _("Add")

            %ul#query-dropdown.dropdown-menu{ "aria-labelledby": "newLayerDropdown" }
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createRasterLayer" }
                }
                  %i.bi.bi-grid-3x3.me-2
                  = _("Custom raster layer")
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createHikingWaymarkedtrailsLayer" }
                }
                  🥾 waymarkedtrails.org: hiking
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createCyclingWaymarkedtrailsLayer" }
                }
                  🚴 waymarkedtrails.org: cycling
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createMtbWaymarkedtrailsLayer" }
                }
                  🚵 waymarkedtrails.org: mtb
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createSlopesWaymarkedtrailsLayer" }
                }
                  ⛷️ waymarkedtrails.org: slopes
              %li
                %hr.dropdown-divider
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createSelectedOverpassLayer", query_name: "Custom query" }
                }
                  %i.bi.bi-pencil-square.me-2
                  = _("Custom Overpass query")
              / Predefined queries, must match definitions in maplibre/layers/queries.js
              - # query_name stays untranslated, it is the lookup key into queries.js
              :ruby
                overpass_queries = [N_('🚻 Public toilets'), N_('🍻 Breweries'), N_('🚇 Subway'), N_('🚰 Drinking water'),
                N_('🚶🏾 Hiking routes'), N_('🚴 Bicycle routes'), N_('🏕️ Camping'), N_('🚒 Feuerwehr'), N_('👨🏻‍🚒 Hydranten'),
                N_('🚆 Trains'), N_('🛜 Wifi'), N_('🏪 Food Shops'), N_('🏊 Swimming pools') ]
              - overpass_queries.each do |query_name|
                %li
                  %button.dropdown-item{
                    type: "button",
                    data: { action: "click->map--layers#createSelectedOverpassLayer", query_name: query_name }
                  }
                    = _(query_name)
              %li
                %hr.dropdown-divider
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createWikipediaLayer" }
                }
                  %i.bi.bi-wikipedia.me-2
                  = _("Wikipedia articles")
              - if ENV['INDOOREQUAL_KEY'].present?
                %li
                  %button.dropdown-item{
                    type: "button",
                    data: { action: "click->map--layers#createIndoorLayer" }
                  }
                    %i.bi.bi-building.me-2
                    = _("OpenStreetMap indoor")
              %li
                %hr.dropdown-divider
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createBaseMapLayer" }
                }
                  = _("Basemap Info (experimental)")
              %li
                %button.dropdown-item{
                  type: "button",
                  data: { action: "click->map--layers#createOsmLayer" }
                }
                  = _("OSM Info (experimental)")

      - # used by controls/shared.js
      .hidden
        #layer-item-template.layer-item.feature-section-card
          %h5.layer-item-header.mb-0.ms-1
            %span.w-100.link{ data: { action: "click->map--layers#toggleLayerList" }}
              %i.bi.bi-caret-right-fill
              %span.mapforge-font.layer-name.me-2= _("Layer name")
            -# Desktop (and mobile when there is only one): inline buttons
            %span.text-nowrap.d-none.d-sm-inline.me-2
              %button.hidden.ms-2.btn.btn-secondary.btn-layer-actions.layer-visibility{ data: { action: "click->map--layers#toggleLayerVisibility", "toggle": 'tooltip', "bs-trigger": 'hover' }, title: _("Hide layer") }
                %i.bi.bi-eye
              %button.hidden.btn.btn-secondary.btn-layer-actions.layer-refresh.ms-2{ data: { action: "click->map--layers#refreshLayer", "toggle": 'tooltip', "bs-trigger": 'hover' }, title: _("Refresh layer for current view") }
                %i.bi.bi-arrow-clockwise.reload-icon
              %button.hidden.btn.btn-secondary.btn-layer-actions.layer-edit.ms-2{ data: { action: "click->map--layers#toggleEdit", "toggle": 'tooltip', "bs-trigger": 'hover' }, title: _("Edit query") }
                %i.bi.bi-pencil-square
              %button.hidden.btn.btn-orange.btn-layer-actions.layer-delete.ms-2{ data: { action: "click->map--layers#deleteLayer", "toggle": 'tooltip', "bs-trigger": 'hover' }, title: _("Delete Layer") }
                %i.bi.bi-trash
            -# Mobile: dropdown menu
            .dropdown.d-sm-none.d-inline.layer-actions-dropdown
              -# fixed strategy: the menu escapes the scrollable modal body without turning off its overflow
              %button.btn.btn-secondary.btn-layer-actions.ms-2.me-2{ type: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false", "data-bs-popper-config": '{"strategy":"fixed"}' }
                %i.bi.bi-three-dots-vertical
              %ul.dropdown-menu.dropdown-menu-end
                %li
                  %button.hidden.dropdown-item.layer-visibility-mobile{ type: "button", data: { action: "click->map--layers#toggleLayerVisibility" } }
                    %i.bi.bi-eye.me-2
                    %span.layer-visibility-text= _("Hide layer")
                %li
                  %button.hidden.dropdown-item.layer-refresh-mobile{ type: "button", data: { action: "click->map--layers#refreshLayer" } }
                    %i.bi.bi-arrow-clockwise.me-2
                    = _("Refresh")
                %li
                  %button.hidden.dropdown-item.layer-edit-mobile{ type: "button", data: { action: "click->map--layers#toggleEdit" } }
                    %i.bi.bi-pencil-square.me-2
                    = _("Edit query")
                %li
                  %button.hidden.dropdown-item.text-danger.layer-delete-mobile{ type: "button", data: { action: "click->map--layers#deleteLayer" } }
                    %i.bi.bi-trash.me-2
                    = _("Delete")

          .layer-content.mt-2.hidden
            .overpass-edit.hidden
              .mb-2.form-floating
                %input.mw-400.form-control.overpass-name{type: 'text', autocomplete: 'off', placeholder: _('Enter name / Search queries'), name: 'overpass-name'}
                %label{ for: "overpass-name"}= _("Title")
                .autocomplete-list.dropdown-menu

              .mb-3.form-floating
                %textarea.mb-1.form-control.overpass-query{name: 'overpass-query', data: { action: "input->map--layers#resizeQueryField"} }
                %label{ for: "overpass-query"}= _("Query")
                %span.d-none.d-sm-inline.overpass-docs
                  %i.bi.bi-info-circle-fill
                  = link_to _('Overpass tutorial'), doc_path(id: 'overpass_layers'), { target: '_blank', rel: 'noopener noreferrer' }

                %button.btn.btn-blue{ 'data-action': 'click->map--layers#updateOverpassLayer'}
                  %span.d-none.d-sm-inline= _("Update Layer")
                  %span.d-sm-none= _("Update")

            .raster-edit.hidden
              .mb-2.form-floating
                %input.mw-400.form-control.raster-name{type: 'text', autocomplete: 'off', placeholder: _('Layer name')}
                %label= _("Title")

              .mb-3.form-floating
                %input.form-control.raster-url{type: 'text', autocomplete: 'off', placeholder: 'https://tile.example.com/{z}/{x}/{y}.png'}
                %label= _("Raster URL (https://<host>/{z}/{x}/{y}.png)")

                %button.btn.btn-blue.mt-1{ 'data-action': 'click->map--layers#updateRasterLayer'}
                  %span.d-none.d-sm-inline= _("Update Layer")
                  %span.d-sm-none= _("Update")

            %ul.list-unstyled

      #layers.mt-2
