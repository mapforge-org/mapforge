/ default values will get up by initSettingsModal(), current values by callbacks
- data = { controller: 'map--modal map--settings',
           map__settings_current_pitch_value: @map_properties[:pitch].to_f.round(0),
           map__settings_current_zoom_value: (@map_properties[:zoom] || @map_properties[:default_zoom] || @client_zoom).to_f.round(2),
           map__settings_current_bearing_value: @map_properties[:bearing].to_f.round(0),
           map__settings_current_center_value: (@map_properties[:center] || @map_properties[:default_center] || @client_center),
           action: "keydown.esc@window->map--modal#close" }

#settings-modal.modal-center.fade{ data: data }
  .map-modal
    %button.modal-close-button{ data: { action: "click->map--modal#close" } } &times;
    .map-modal-header
      %h3.mapforge-font= _("Configure Map")

    .map-modal-content.inline-scroll

      .feature-section-card
        - if map_editable?
          .form-floating.edit-ui.rw-only
            %input.form-control#map-name{"name": "map-name", type: "text", size: 27, data: { action: "input->map--settings#updateName" } }
            %label{ for: "map-name"}
              %b= _("Name:")

          %button#map-description-toggle.mt-2.btn.btn-sm.btn-secondary.rw-only{ type: "button", data: { action: "click->map--settings#showDescriptionEditor" } }
            %i.bi.bi-plus-square.me-1
            %span.d-none.d-sm-inline= _("Add description")
            %span.d-sm-none= _("Description")

          #map-description.hidden.form-floating.mt-2.rw-only
            %textarea.form-control#map-description-input

        #map-description-view.ro-only

      - if map_editable?
        - # Open on an untouched map only, the same rule that opens this modal in edit.js
        - untouched = @map.name.blank? && @map.layers.all? { |layer| layer.type == "geojson" && layer.features_count.to_i.zero? }
        %details.feature-section-card.rw-only{ open: untouched }
          %summary
            %h4.mapforge-font.mt-2.d-inline= _("What do you want to do?")

          .welcome-tiles
            %button.welcome-tile{ type: "button", data: { action: "click->map--modal#close" } }
              %i.bi.bi-brush
              %span= _("Paint objects on the map")

            %button.welcome-tile{ type: "button", disabled: @user.nil?,
              data: { action: "click->map--settings#importFile" } }
              %i.bi.bi-upload
              %span= _("Import data (gpx, kml, image)")

            - if ENV["OPENROUTESERVICE_KEY"].present?
              .welcome-tile
                .welcome-tile-icons
                  %button{ type: "button", title: _("Walking route"),
                    data: { action: "click->map--settings#startRoute", "map--settings-mode-param": "directions_foot" } }
                    %i.bi.bi-person-walking
                  %button{ type: "button", title: _("Bike route"),
                    data: { action: "click->map--settings#startRoute", "map--settings-mode-param": "directions_bike" } }
                    %i.bi.bi-bicycle
                  %button{ type: "button", title: _("Car route"),
                    data: { action: "click->map--settings#startRoute", "map--settings-mode-param": "directions_car" } }
                    %i.bi.bi-car-front-fill
                %span= _("Create a route")

            %button.welcome-tile{ type: "button", data: { action: "click->map--settings#openLayers" } }
              %i.bi.bi-stack
              %span= _("Add OpenStreetMap layers")

          - unless @user
            %p.small.mt-2.mb-0
              %i.bi.bi-info-circle.me-1
              = _("Please log in to import files")

      .feature-section-card
        %h4.mapforge-font.mt-2
          = _("Background map")

        - maps = (@user&.admin? ? Map::BASE_MAPS + Map::EXPERIMENTAL_MAPS : Map::BASE_MAPS)
        - maps -= Map::PROTOMAPS_MAPS if ENV["PROTOMAPS_KEY"].blank?
        - maps -= Map::THUNDERFOREST_MAPS if ENV["THUNDERFOREST_KEY"].blank?
        - maps.each do |base_map|
          - active = (@map_properties[:base_map] == base_map)
          - map_image = "base_maps/placeholder.jpg"
          - if Rails.application.assets.find_asset("base_maps/#{base_map}.jpg").present?
            - map_image = "base_maps/#{base_map}.jpg"
          = image_tag(map_image, data: { base_map: base_map, action: "click->map--settings#updateBaseMap" }, class: "layer-preview", loading: 'lazy')

        .map-settings
          - # Default checkbox state gets set by initSettingsModal()
          %span.no-wrap.me-2
            %label{ for: "map-terrain"}= _("3D Terrain:")
            %input#map-terrain{type: "checkbox", data: { action: "click->map--settings#updateTerrain"} }

          %span.no-wrap.me-2
            %label{ for: "map-hillshade"}= _("Hillshade:")
            %input#map-hillshade{type: "checkbox", data: { action: "click->map--settings#updateHillshade"} }

          %span.no-wrap.me-2
            %label{ for: "map-contours"}= _("Contour lines:")
            %input#map-contours{type: "checkbox", data: { action: "click->map--settings#updateContours"} }

          %span.no-wrap.me-2
            %label{ for: "map-globe"}= _("Globe:")
            %input#map-globe{type: "checkbox", data: { action: "click->map--settings#updateGlobe"} }


      - if map_editable?
        .feature-section-card.rw-only
          %h4.mapforge-font.mt-2= _("View")

          %p= _("Default view when opening this map.")

          .view-mode
            %label.view-card
              %input#map-view-auto{ type: "radio", name: "map-view-mode", autocomplete: "off",
                data: { action: "change->map--settings#resetDefaultView" } }
              .view-card-main
                .view-card-title
                  %i.bi.bi-bounding-box.me-1
                  = _("Auto")
                .view-card-body= _("The map starts centered on your content.")

            %label.view-card
              %input#map-view-fixed{ type: "radio", name: "map-view-mode", autocomplete: "off",
                data: { action: "change->map--settings#setFixedView" } }
              .view-card-main
                .view-card-title
                  %i.bi.bi-geo-alt.me-1
                  = _("Fixed view")
                .view-card-body
                  %span.no-wrap
                    %i.bi.bi-crosshair.me-1
                    %span.view-values.selectable#map-center>

                  %span.no-wrap
                    %i.bi.bi-zoom-in.me-1
                    %span.view-values.selectable#map-zoom>

                  %span.no-wrap
                    %i.bi.bi-triangle.me-1
                    %span.view-values.selectable#map-pitch>

                  %span.no-wrap
                    %i.bi.bi-arrow-counterclockwise.me-1
                    %span.view-values.selectable#map-bearing>

                  %button.btn.btn-blue.btn-sm.no-wrap#save-map-defaults{ data: { action: "click->map--settings#updateDefaultView" } }
                    %span.d-none.d-sm-inline= _("Set current view as default")
                    %span.d-sm-none= _("Set as default")
