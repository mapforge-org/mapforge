#feature-details-modal.map-modal.modal-pull-transition.fade{
  'data-controller': "map--modal feature--modal feature--edit",
  'data-action': "keydown.del@window->feature--edit#delete_feature \
    keydown.esc@window->map--modal#close \
    toggle-edit-feature@window->feature--modal#toggle_edit_feature \
    keydown.ctrl+c@window->feature--modal#copy" }

  -# header and tabs stay, the content between them and the export bar scrolls
  .feature-modal-top
    %a.link{ 'data-action': "click->feature--modal#toggleModalSize"}
      .modal-pull-button

    %button.modal-close-button{ 'data-action': "click->map--modal#close" } &times;
    .feature-modal-header
      %h4#feature-details-header.flex-container.flex-no-wrap.flex-vcenter
        .feature-symbol.me-2
        .feature-heading
          #feature-title.selectable.no-wrap
          #feature-subtitle.selectable.no-wrap.hidden

    #edit-buttons.feature-edit-tabs.hidden.flex-center
      %button#edit-button-details.feature-tab-btn{ type: "button", 'data-action': "click->feature--modal#toggle_edit_feature", 'data-edit-type': 'details', title: _('View feature information'), 'data-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-trigger': "hover" }
        %i.bi.bi-file-text
        .tab-label= _("Details")
      %button#edit-button-geometry.feature-tab-btn{ type: "button", 'data-action': "click->feature--modal#toggle_edit_feature", 'data-edit-type': 'geometry', title: _('Edit shape on map'), 'data-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-trigger': "hover" }
        %i.bi.bi-bounding-box
        .tab-label= _("Geometry")
      %button#edit-button-edit.feature-tab-btn{ type: "button", 'data-action': "click->feature--modal#toggle_edit_feature", 'data-edit-type': 'ui', 'data-edit-tab': 'properties', title: _('Edit title and description'), 'data-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-trigger': "hover" }
        %i.bi.bi-pencil
        .tab-label= _("Properties")
      %button#edit-button-style.feature-tab-btn{ type: "button", 'data-action': "click->feature--modal#toggle_edit_feature", 'data-edit-type': 'ui', 'data-edit-tab': 'style', title: _('Change colors and appearance'), 'data-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-trigger': "hover" }
        %i.bi.bi-palette
        .tab-label= _("Style")
      %button#edit-button-advanced.feature-tab-btn{ type: "button", 'data-action': "click->feature--modal#toggle_edit_feature", 'data-edit-type': 'ui', 'data-edit-tab': 'advanced', title: _('Convert to route and edit JSON'), 'data-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-trigger': "hover" }
        %i.bi.bi-code-slash
        .tab-label= _("Advanced")

  .feature-modal-scroll
    = render 'maps/modals/feature/edit_ui'

    #feature-details-body.selectable
      #feature-stats.feature-stats.hidden

      #feature-details-description
      %button#feature-description-more.btn.btn-link.hidden{ type: "button", data: { action: "click->feature--modal#toggleDescription" } }

      #feature-details-elevation.feature-section-card.hidden
        %h5.feature-card-title
          %svg.card-icon{ viewBox: "0 0 16 16", 'aria-hidden': "true" }
            %path{ d: "M1.5 13.5h13V2.5l-4.5 5-2-1.5z", fill: "none", stroke: "currentColor", 'stroke-width': "1.5", 'stroke-linejoin': "round" }
          = _("Elevation profile")
        -# chart.js sizes the canvas to its parent, which holds nothing else
        .elevation-chart
          %canvas#route-elevation-chart
        -# maplibre/feature/elevation.js fills it for the point under the mouse or finger
        -# the same values as the hover card on the map, see hover_info.js
        #elevation-here.track-position.idle
          .here-hint
          .hover-position

      #feature-details-extras.feature-extras.hidden

    #feature-details-meta.mt-2.flex-center
      %span#feature-size.center.selectable.text-nowrap
      %span#feature-vertexes.selectable.text-nowrap.d-none.d-sm-inline

    -# sticks to the bottom of the modal, a bottom sheet shows it at the end of the content, see feature.css
    #feature-export-bar.feature-modal-footer.hidden
      %span.feature-export-label= _("Export")
      .feature-export-buttons
        = link_to map_feature_gpx_path(id: @map.public_id, feature_id: 'feature_id'), id: 'feature-export-gpx', class: 'btn-export', download: "", title: _('Download as GPX'), data: { turbo: false, toggle: "tooltip", 'bs-placement': "top", 'bs-trigger': "hover" } do
          %i.bi.bi-download
          GPX
        = link_to map_feature_geo_path(id: @map.public_id, feature_id: 'feature_id'), id: 'feature-export-geo', class: 'btn-export', target: '_blank', title: _('Download as geoJSON'), 'data-toggle': "tooltip", 'data-bs-placement': "top", 'data-bs-trigger': "hover" do
          %i.bi.bi-download
          GeoJSON
        - if @user && ENV["GARMIN_CLIENT_ID"].present?
          %span#feature-export-garmin.btn-export
            - if @user.garmin_token
              %a.garmin-upload{ href: '#', title: _('Send to Garmin Connect'), data: { action: "click->feature--modal#sendToGarmin", url: map_feature_garmin_path(id: @map.public_id, feature_id: 'feature_id'), toggle: "tooltip", 'bs-placement': "top", 'bs-trigger': "hover" } }
                %i.bi.bi-cloud-upload
                %span Garmin
            - else
              = form_tag('/auth/garmin', method: 'post', class: 'd-inline', data: { turbo: false }) do
                = hidden_field_tag :origin, request.original_url
                = button_tag class: 'garmin-connect', title: _('Connect Garmin Connect to send tracks to your device') do
                  %i.bi.bi-cloud-upload
                  Garmin
