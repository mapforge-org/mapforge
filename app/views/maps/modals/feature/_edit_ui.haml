#feature-edit-ui.hidden

  .feature-edit-section{ 'data-edit-section': "geometry" }
    .geometry-hint.text-center.text-muted.pt-3.pb-3
      %p#geometry-hint-point.edit-point= _("Drag the point to move it")
      %p#geometry-hint-line.edit-line= _("Drag vertices to reshape")
      %p#geometry-hint-polygon.edit-polygon= _("Drag vertices to reshape")
      %p#geometry-hint-routed.hidden= _("Drag or add waypoints to reroute")

  .feature-edit-section{ 'data-edit-section': "properties" }
    .feature-section-card.pt-2
      #feature-title-input.edit-ui.form-floating
        %input.form-control{ "name": "feature-title", data: { action: "input->feature--edit#addUndo input->feature--edit#updateTitle" } }
        %label{ for: "feature-title"}= _("Title")

      #feature-show-title-ui.edit-ui.ms-2
        %input#feature-show-title-on-map{ type: "checkbox", data: { action: "input->feature--edit#addUndo input->feature--edit#updateShowTitleOnMap change->feature--edit#saveFeature" } }
        %label{ for: "feature-show-title-on-map"}= _("Show title on map")

      .edit-ui
        %button#button-add-desc.mt-1.btn.btn-sm.btn-secondary{ type: "button", 'data-action': "click->feature--modal#show_add_desc" }
          %i.bi.bi-plus-square.me-1
          = _("Add description")

    #feature-desc-section.feature-section-card.hidden
      #feature-desc
        %textarea#feature-desc-input
      #desc-shape-ui.edit-ui.edit-point
        %label.left-label= _("Show on map:")
        .btn-group.segmented{ role: "group" }
          %button.btn{ type: "button", title: _("Not shown"),
            data: { 'desc-shape': "none", action: "click->feature--edit#addUndo click->feature--edit#updateDescShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-slash-circle
          %button.btn{ type: "button", title: _("Banner"),
            data: { 'desc-shape': "banner", action: "click->feature--edit#addUndo click->feature--edit#updateDescShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-chat-square-fill
          %button.btn{ type: "button", title: _("Square"),
            data: { 'desc-shape': "square", action: "click->feature--edit#addUndo click->feature--edit#updateDescShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-square-fill
          %button.btn{ type: "button", title: _("Text bubble"),
            data: { 'desc-shape': "bubble", action: "click->feature--edit#addUndo click->feature--edit#updateDescShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-chat-fill

  .feature-edit-section.hidden{ 'data-edit-section': "style" }
    .feature-section-card.pt-2
      #point-size-ui.edit-ui.edit-point
        %label.left-label{ for: "point-size"}= _("Size:")
        %input.slider#point-size{ type: "range", min: "1", max: "75", value: "1", 'data-action': "input->feature--edit#addUndo input->feature--edit#updatePointSize  change->feature--edit#saveFeature" }
        %span#point-size-val.text-muted.small
        .stepper{ 'data-stepper-for': "point-size", 'data-stepper-step': "1" }
          %button.stepper-btn.stepper-btn-dec{ type: "button" } −
          %span.stepper-val
          %button.stepper-btn.stepper-btn-inc{ type: "button" } +

      #line-width-ui.edit-ui.edit-line
        %label.left-label{ for: "line-width"}= _("Width:")
        %input.slider#line-width{ type: "range", min: "1", max: "15", value: "1", 'data-action': "input->feature--edit#addUndo input->feature--edit#updateLineWidth change->feature--edit#saveFeature" }
        %span#line-width-val.text-muted.small
        .stepper{ 'data-stepper-for': "line-width", 'data-stepper-step': "1" }
          %button.stepper-btn.stepper-btn-dec{ type: "button" } −
          %span.stepper-val
          %button.stepper-btn.stepper-btn-inc{ type: "button" } +

      #outline-width-ui.edit-ui.edit-polygon
        %label.left-label{ for: "outline-width"}= _("Border width:")
        %input.slider#outline-width{ type: "range", min: "0", max: "15", value: "1", 'data-action': "input->feature--edit#addUndo input->feature--edit#updateOutLineWidth change->feature--edit#saveFeature" }
        %span#outline-width-val.text-muted.small
        .stepper{ 'data-stepper-for': "outline-width", 'data-stepper-step': "1" }
          %button.stepper-btn.stepper-btn-dec{ type: "button" } −
          %span.stepper-val
          %button.stepper-btn.stepper-btn-inc{ type: "button" } +

      -# filled by feature--modal#updateColorPresets, shown as swatches by the native color picker
      %datalist#color-presets

      #stroke-color-ui.edit-ui.edit-line.edit-polygon.edit-point
        %label.left-label.edit-line{ for: "stroke-color"}= _("Line color:")
        %label.left-label.edit-polygon.edit-point{ for: "stroke-color"}= _("Border color:")
        %select#stroke-color-mode.form-select.form-select-sm.hidden{ data: { action: "change->feature--edit#addUndo change->feature--edit#updateStrokeColorMode change->feature--edit#saveFeature" } }
          %option{ value: "" }= _("Color")
        %input.form-control#stroke-color{ type: "color", list: "color-presets", 'data-action': "input->feature--edit#addUndo input->feature--edit#updateStrokeColor change->feature--edit#saveFeature" }
        %div.edit-polygon.edit-point
          %input#stroke-color-transparent{type: "checkbox", data: { action: "input->feature--edit#addUndo input->feature--edit#updateStrokeColorTransparent change->feature--edit#saveFeature"} }
          %label{ for: "stroke-color-transparent"}= _("transparent")

      #fill-color-ui.edit-ui.edit-polygon.edit-point
        %label.left-label{ for: "fill-color"}= _("Color:")
        %input.form-control#fill-color{ type: "color", list: "color-presets", 'data-action': "input->feature--edit#addUndo input->feature--edit#updateFillColor change->feature--edit#saveFeature" }
        %div
          %input#fill-color-transparent{type: "checkbox", value: 'transparent', data: { action: "input->feature--edit#addUndo input->feature--edit#updateFillColorTransparent change->feature--edit#saveFeature"} }
          %label{ for: "fill-color-transparent"}= _("transparent")

      -# Each button carries what it holds, and 'Fill' is what takes an image or a pattern off
         again. The image is pinned to the corners of the polygon, see image_overlays.js
      #fill-image-ui.edit-ui.edit-polygon
        %label.left-label= _("Background:")
        .btn-group.segmented{ role: "group" }
          %button#fill-plain-button.btn{ type: "button", title: _("Fill color"),
            data: { background: "fill", action: "click->feature--edit#updateBackground",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-square-fill
            %span.btn-label= _("Fill")
          -# the tooltip text says why the button is off, syncBackground writes it
          %button#fill-image-button.btn{ type: "button", disabled: !@user,
            data: { background: "image", action: "click->feature--edit#updateBackground",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %span#fill-image-preview
            %i.bi.bi-image
            %span.btn-label= _("Image")
          -# fixed strategy: the menu escapes the clipped row without turning off its overflow.
             No tooltip here, Bootstrap binds one component per element and this one is a dropdown.
          %button#fill-pattern-button.btn{ type: "button", 'aria-label': _("Pattern"),
            data: { background: "pattern", action: "click->feature--edit#updateBackground",
              'bs-toggle': "dropdown", 'bs-popper-config': '{"strategy":"fixed"}' } }
            %span#fill-pattern-preview
            %i.bi.bi-grid-3x3
            %span.btn-label= _("Pattern")
          -# filled by syncBackground, the swatches carry the colors of the feature
          %ul#fill-pattern-menu.dropdown-menu
        -# visually-hidden, not hidden: mobile Safari opens no file dialog for a click() on a
           'display: none' input, so the input has to stay in the layout
        - if @user
          %input#fill-image.visually-hidden{ type: "file", accept: "image/*",
            'data-action': "input->feature--edit#addUndo change->feature--edit#updateFillImage" }

      #opacity-ui.edit-ui.edit-polygon
        %label.left-label{ for: "opacity"}= _("Opacity:")
        %input.slider#opacity{ type: "range", min: "1", max: "10", value: "9", 'data-action': "input->feature--edit#addUndo input->feature--edit#updateOpacity change->feature--edit#saveFeature" }
        %span#opacity-val.text-muted.small
        .stepper{ 'data-stepper-for': "opacity", 'data-stepper-step': "1" }
          %button.stepper-btn.stepper-btn-dec{ type: "button" } −
          %span.stepper-val
          %button.stepper-btn.stepper-btn-inc{ type: "button" } +

      #marker-shape-ui.edit-ui.edit-point
        %label.left-label= _("Shape:")
        .btn-group.segmented{ role: "group" }
          %button.btn{ type: "button", title: _("Circle"),
            data: { shape: "circle", action: "click->feature--edit#addUndo click->feature--edit#updateShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-circle-fill
          %button.btn{ type: "button", title: _("Pin"),
            data: { shape: "pin", action: "click->feature--edit#addUndo click->feature--edit#updateShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-geo-alt-fill
          %button.btn{ type: "button", title: _("Square"),
            data: { shape: "square", action: "click->feature--edit#addUndo click->feature--edit#updateShape",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-square-fill

      -# Each button carries what it holds, and a click on the active one opens its picker again.
      #marker-content-ui.edit-ui.edit-point
        %label.left-label= _("Symbol:")
        %input#marker-symbol{ type: "hidden", inputmode: 'emoji' }
        .btn-group.segmented{ role: "group" }
          %button.btn{ type: "button", title: _("None"),
            data: { content: "none", action: "click->feature--edit#updateMarkerContent",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %i.bi.bi-slash-circle
            %span.btn-label= _("None")
          %button.btn{ type: "button", title: _("Icon"),
            data: { content: "symbol", action: "click->feature--edit#updateMarkerContent",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %span#emoji
            %i.bi.bi-emoji-smile
            %span.btn-label= _("Icon")
          %button.btn{ type: "button", disabled: !@user,
            title: @user ? _("Max. 5MB") : _("Please log in to upload images"),
            data: { content: "image", action: "click->feature--edit#updateMarkerContent",
              toggle: "tooltip", 'bs-trigger': "hover" } }
            %span#marker-image-preview
            %i.bi.bi-image
            %span.btn-label= _("Image")
        -# visually-hidden, not hidden: mobile Safari opens no file dialog for a click() on a
           'display: none' input, so the input has to stay in the layout
        - if @user
          %input#marker-image.visually-hidden{ type: "file", accept: "image/*",
            'data-action': "input->feature--edit#addUndo change->feature--edit#updateMarkerImage" }

      #fill-extrusion-height-ui.edit-ui.edit-line.edit-polygon
        %label.left-label{ for: "fill-extrusion-height"}= _("Height:")
        %input.slider#fill-extrusion-height{ type: "range", min: "0", max: "500", value: "0", 'data-action': "input->feature--edit#addUndo input->feature--edit#updateFillExtrusionHeight change->feature--edit#saveFeature" }
        %span#fill-extrusion-height-val.text-muted.small
        .stepper{ 'data-stepper-for': "fill-extrusion-height", 'data-stepper-step': "10" }
          %button.stepper-btn.stepper-btn-dec{ type: "button" } −
          %span.stepper-val
          %button.stepper-btn.stepper-btn-inc{ type: "button" } +

      #show-km-markers-ui.edit-ui.edit-line
        %label.edit-line{ for: "show-km-markers"}= _("Distance markers:")
        %input#show-km-markers{type: "checkbox", data: { action: "input->feature--edit#addUndo input->feature--edit#updateShowKmMarkers change->feature--edit#saveFeature"} }

  .feature-edit-section.hidden{ 'data-edit-section': "advanced" }
    #convert-to-route-section.feature-section-card.hidden
      .feature-details-card-header#convert-to-route-header
        %h5
          %i.bi.bi-signpost-split-fill.me-2
          = _("Convert to route")
        %i.bi.bi-chevron-down.extras-totals-chevron
      #convert-to-route-content.hidden.p-2
        %p.text-muted.mb-2
          = _("Copy and transform this line into a routed track with waypoints, elevation and surface info.")
        .flex-center.gap-2
          %button.btn.btn-sm.btn-outline-secondary{'data-convert-profile': 'foot'}
            %i.bi.bi-person-walking
            = _("Foot")
          %button.btn.btn-sm.btn-outline-secondary{'data-convert-profile': 'bike'}
            %i.bi.bi-bicycle
            = _("Bicycle")
          %button.btn.btn-sm.btn-outline-secondary{'data-convert-profile': 'car'}
            %i.bi.bi-car-front
            = _("Car")

    .feature-section-card
      .feature-details-card-header#style-json-section-header
        %h5
          %i.bi.bi-code-slash.me-2
          = _("Style JSON")
        %i.bi.bi-chevron-down.extras-totals-chevron
      #style-json-section-content.hidden.pt-2
        = render 'maps/modals/feature/edit_raw'

    .feature-section-card
      .feature-details-card-header#geometry-json-section-header
        %h5
          %i.bi.bi-code-slash.me-2
          = _("Geometry JSON")
        %i.bi.bi-chevron-down.extras-totals-chevron
      #geometry-json-section-content.hidden.pt-2
        = render 'maps/modals/feature/edit_raw_geometry'

    .feature-section-card.pt-2
      %button#edit-button-trash.feature-delete-btn{ type: "button", title: _("Delete feature"), data: { action: "click->feature--edit#delete_feature" } }
        %i.bi.bi-trash
        = _("Delete")
