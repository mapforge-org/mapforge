#feature-edit-raw-geometry.raw-json-editor

  %textarea.embed-code.form-control{name: "geometry", rows: "6", cols: "50" }
  %span.error

  .d-flex.justify-content-between.align-items-center.mt-2
    %button.btn.btn-blue.feature-update{ 'data-action': "click->feature--edit#update_feature_geometry"}= _("Update")
    %button.btn.btn-secondary.fullscreen-toggle{ type: "button", 'data-action': "click->feature--edit#toggleFullscreen", title: _("Toggle fullscreen"), 'data-toggle': "tooltip", 'data-bs-trigger': "hover" }
      %i.bi.bi-fullscreen
