#feature-edit-raw.raw-json-editor

  %textarea.embed-code.form-control{name: "properties", rows: "6", cols: "50", "data-feature-target": "properties" }
  %span.error

  .d-flex.justify-content-between.align-items-center.mt-2
    %button.btn.btn-blue.feature-update{ 'data-action': "click->feature--edit#update_feature_raw"}= _("Update")
    .d-flex.align-items-center.gap-2
      %button.btn.btn-secondary.fullscreen-toggle{ type: "button", 'data-action': "click->feature--edit#toggleFullscreen", title: _("Toggle fullscreen"), 'data-toggle': "tooltip", 'data-bs-trigger': "hover" }
        %i.bi.bi-fullscreen
      = link_to doc_path(id: 'geojson_style_spec'), { target: '_blank', rel: 'noopener noreferrer', class: 'btn btn-secondary text-nowrap', title: _('Style Help'), 'data-toggle': "tooltip", 'data-bs-trigger': "hover" } do
        %i.bi.bi-box-arrow-up-right.me-1.style-help-icon
        %i.bi.bi-question-circle.style-help-icon-mobile
        %span.style-help-label= _("Style Help")
