- rw = local_assigns[:rw] || false

.grid-item.map-preview.background-bright{class: "map_#{map.public_id}"}

  - unless map.view_permission == 'listed'
    .map-auth{title: _('This map is private and not linked from the public listing.')}
      %i.bi.bi-lock-fill

  .preview-image-link
    = link_to(map_path(id: (rw ? map.private_id : map.public_id), name: map.name), 'aria-label': _("Open map '%{name}'") % { name: map.name }) do
      - if map.screenshot
        %img{src: map.screenshot,
            class: 'preview-image',
            loading: 'lazy',
            alt: _("Map '%{name}'") % { name: map.name }}
      - else
        = image_tag "preview.png", class: 'preview-image preview-placeholder', loading: 'lazy', alt: _("Map '%{name}'") % { name: map.name }
    .map-preview-title.mapforge-font.text-glow= map.name
