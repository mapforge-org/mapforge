- content_for :title, "Mapforge: Recently watched and My maps"

#maps

  - if @recent_maps.present?
    %h1.mapforge-font
      %span.d-none.d-sm-inline= _("Recently viewed Maps")
      %span.d-sm-none= _("Recently viewed")
    .maps-list.recently-viewed-maps.mb-4
      - @recent_maps.each do |recent_map, rw|
        = render recent_map, rw: rw


  = render "list_filter", title: _("Your Maps"), count: @my_maps.size, tags: false
  = render "list" , maps: @my_maps, partial: "maps/map_card"


  - if @my_maps.empty?
    .container.pt-4.pb-2.mt-4.mb-4.empty-map-list.background-bright
      %p.text-center
        = _("In this gallery, your personal maps will be shown.")
        %br
        - playground_link = link_to(_("Playground"), playground_path, class: 'btn btn-orange call-to-action')
        - create_link = link_to(_('create'), create_map_path, class: 'btn btn-orange call-to-action', data: { turbo_method: :post })
        = raw(_("You can try out the %{playground_link} to learn how Mapforge works, or you can %{create_link} your first map right away.") % { playground_link: playground_link, create_link: create_link })
