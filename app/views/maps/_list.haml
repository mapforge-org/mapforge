- maps = local_assigns[:maps] || @maps || []
- partial = local_assigns[:partial] || "maps/map"

#maps-list.maps-list

  .grid-container{ data: { 'controller': "header", 'action': "click->header#hideNavDropdown" } }
    = render partial: partial, collection: maps, as: :map, locals: { admin: local_assigns[:admin] }
