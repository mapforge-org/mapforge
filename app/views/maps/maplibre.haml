= javascript_include_tag "osmtogeojson.js", async: true

- if @map_mode == 'rw'
  - # https://github.com/Ionaru/easy-markdown-editor
  = stylesheet_link_tag "easymde.min.css" # v2.20.0, manual update

- content_for :title, "Mapforge map: #{@map.name.presence}" if @map.name.presence
- content_for :head do
  - # Speed up default basemap tile fetches (versatilesColorful uses tiles.versatiles.org)
  %link{ rel: "preconnect", href: "https://tiles.versatiles.org", crossorigin: true }
  %link{ rel: "dns-prefetch", href: "https://tiles.versatiles.org" }
  - # Open Graph protocol https://ogp.me/
  - if @map.name
    %meta{ property: 'og:title', content: @map.name }
  - if @map.description
    %meta{ property: 'og:description', content: @map.description }
  - if @map.screenshot
    %meta{ property: 'og:image', content: "#{request.protocol}#{request.host_with_port}#{@map.screenshot}" }


#preloader
  %img.preloader-logo{ src: "/icons/preloader.svg", alt: "Loading" }

#map-error.hidden.background-dark
  %h2= _("This map needs WebGL2")
  %p= _("Your browser cannot render 3D graphics on the web. Update your browser, or turn on hardware acceleration in the browser settings.")
  %p= link_to _("More about WebGL"), "https://wiki.openstreetmap.org/wiki/This_map_requires_WebGL", target: "_blank", rel: "noopener"

- unless params['static'] == 'true'
  -# map header and title
  %nav.mapforge-font#map-head.dark-shadow{ data: { 'controller': "header" } }
    - unless params['nomenu'] == 'true'
      #map-nav-toggle.navbar-toggler-icon.ms-2.me-2{ title: _("Show navigation"), data: { 'action': "click->header#toggleNav", 'toggle': "tooltip", 'bs-placement': "bottom" } }
    %h1#map-title{ title: _("Map settings"), data: { 'action': "click->header#openMapSettings", 'toggle': "tooltip", 'bs-placement': "bottom" } }= @map.name

- if params['nomenu'] == 'true'
  = link_to root_url, { '_target': 'blank' } do
    %img.mapforge-embed-logo{ src: "/logo/mapforge-logo-icon.png", alt: "Logo" }

#maplibre-map.map{ data: { 'controller': "map header", 'action': "click->header#hideNav touchstart->header#hideNav keydown.ctrl+v@window->map#paste" } }

- unless @map_mode == 'static'
  = render 'layer_loading'
  = render 'status'
  = render 'maps/modals/settings'
  = render 'maps/modals/layers'
  = render 'maps/modals/share'
  = render 'maps/modals/feature'
  = render 'maps/modals/confirmation'
  = render 'maps/modals/description'
  = render 'maps/modals/context_menu'

#dropdown-space

#remote-cursor-template.remote-cursor.hidden
  %i.bi.bi-cursor-fill.remote-cursor-pointer