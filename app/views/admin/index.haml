- content_for :title, "Mapforge: Admin"
= turbo_stream_from "admin_maps_list"

#maps
  = render "maps/list_filter", title: "Admin", count: @maps.size, filters: "admin/quick_filter"
  = render "maps/list", maps: @maps, partial: "maps/map_card", admin: true

  - if @maps.empty?
    .container.pt-4.mt-4.mb-4.empty-map-list.background-bright
      %p.text-center
        In this gallery, all maps of this instance will be shown.
        %br
        You can browse public maps of all users via the 'Map Gallery' link, or
        you can start with your first map by clicking on the "Create Map" button above.
