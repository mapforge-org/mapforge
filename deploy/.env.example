# Copy this file to .env and edit it. See README.md#environment-variables
# MONGO_URL and REDIS_URL are set by docker-compose.yml.

# Change this before you expose the instance to the internet. Anybody who knows
# the key can forge session cookies. Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=ch4ng3m3

# Login. Without OAuth credentials, enable the local developer login, otherwise
# nobody can log in. The first user that logs in becomes admin.
# DEVELOPER_LOGIN_ENABLED=true
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OSM_CLIENT_ID=
# OSM_CLIENT_SECRET=

# Base maps. Default map identifier: versatilesColorful
# DEFAULT_MAP=
# THUNDERFOREST_KEY=
# PROTOMAPS_KEY=
# INDOOREQUAL_KEY=

# Routing with openrouteservice.org
# OPENROUTESERVICE_KEY=

# MongoDB database name, default: mapforge_production
# MONGO_DB=
